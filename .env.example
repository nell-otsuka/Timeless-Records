# Copy this file to `.env` (it is git-ignored) and change the password.
# `docker compose up` reads it automatically.

# Password of the PostgreSQL database. The database is not exposed outside Docker, but still pick a real one.
POSTGRES_PASSWORD=change-me

# Optional
# WEB_PORT=8787                     # port the app is served on
# TZ=Europe/Paris
# SCRAPE_CRON=0 4 * * *             # daily sync, cron syntax
# SCRAPE_TIMEZONE=Europe/Paris
# SCRAPE_DELAY_MS=1200              # pause between requests to AlloCiné
# ALLOCINE_FETCH_SHOWTIMES=true     # false = only the allowed pages, no hours
